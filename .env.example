# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# ---- บัญชี Duoke (จำเป็น) -------------------------------------------------
# สคริปต์จะล็อกอินให้เอง แล้วเก็บ token ไว้ใน .token.json
# หลังจากนั้นใช้ token เดิมได้หลายวัน รีสตาร์ต nodemon ก็ไม่ถามซ้ำ
--- วิธีล็อกอิน ----------------------------------------------------------
# browser  (ค่าเริ่มต้น) = เปิด Chrome/Edge ให้ล็อกอินเอง แล้วดึง token มาใช้ต่อ
#                    จัดการแคปช่า/2FA ในเบราว์เซอร์ได้ตามปกติ
# terminal = ล็อกอินผ่าน API + พิมพ์แคปช่ารูปภาพในเทอร์มินัล (ต้องมี DUOKE_PASSWORD)
DUOKE_LOGIN=browser
DUOKE_EMAIL=
DUOKE_PASSWORD=
# ถ้าหา Chrome/Edge ไม่เจอ ใส่ path เต็มเอง (โหมด browser)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---- ตัวเลือกการ log ------------------------------------------------------

# log เฉพาะข้อความจากลูกค้า (false = log ข้อความที่ร้านตอบด้วย)
ONLY_BUYER=true

# log ตอนรายการห้องแชทอัปเดต (unread เปลี่ยน ฯลฯ)
SHOW_CONVERSATIONS=false

# ---- ติดแท็กอัตโนมัติ -----------------------------------------------------
# เมื่อมีข้อความจากลูกค้าเข้ามา ให้ติดแท็กนี้ให้ห้องแชทเอง (เผื่อต่อ AI ตอบทีหลัง)
# ถ้ายังไม่มีแท็กชื่อนี้ในบัญชี ระบบจะสร้างให้
AUTO_TAG=true
AUTO_TAG_NAME=รอเจ้าหน้าที่     # ติดเมื่อ AI ไม่ตอบ/เคสละเอียดอ่อน → ให้คนไปตอบ
AUTO_TAG_AI_NAME=AI ตอบ        # ติดเมื่อ AI ตอบลูกค้าไปแล้ว (และเอา "รอเจ้าหน้าที่" ออก)

# ---- แชทบอท AI (จุดต่อ AI อยู่ที่ ai-bot.js) ------------------------------
AI_ENABLED=false          # true = เปิดให้ AI ช่วยตอบ
AI_AUTO_SEND=false        # false = แค่แนะนำคำตอบใน log (ปลอดภัย) · true = ส่งกลับหาลูกค้าจริง

# เลือกวิธีตอบ:
#   anthropic   = Claude API (ต้องมี ANTHROPIC_API_KEY, จ่ายตาม token)
#   openai      = GPT API     (ต้องมี OPENAI_API_KEY, จ่ายตาม token)
#   claude-code = โยนคำถามลงคิว inbox/ ให้ "Claude Code ที่คุยอยู่" หรือคน ตอบผ่าน npm run inbox (ไม่ต้องมี API key)
AI_PROVIDER=anthropic
# ใส่คีย์ให้ตรงกับ provider ที่เลือก (โหมด claude-code ไม่ต้องใส่คีย์)
# ANTHROPIC_API_KEY=sk-ant-...   # จาก https://console.anthropic.com
# OPENAI_API_KEY=sk-...          # จาก https://platform.openai.com
# AI_MODEL=...  # ไม่ใส่=ใช้ตัวเล็ก/ถูก (claude-haiku-4-5 หรือ gpt-4o-mini) · ใหญ่ขึ้น: claude-sonnet-5, gpt-4o
# AI_MAX_HISTORY=10       # จำนวนข้อความล่าสุดที่ป้อนให้ AI เป็นบริบท (ยิ่งเยอะยิ่งเปลือง token)
# AI_MAX_MSG_CHARS=220    # ตัดข้อความของร้านที่ยาวเกินนี้ (กัน auto-reply สำเร็จรูปกิน token)
# AI_CACHE_TTL=5m         # 5m หรือ 1h — แคช prompt ไว้ให้เรียกซ้ำถูกลง 10 เท่า
#   ⚠ แต่ละโมเดลมีขั้นต่ำที่แคชได้: haiku-4-5=4096 tokens · sonnet-5=1024 · opus-5=512
#   prompt ของเราราว 1,800 tokens → haiku แคชไม่ติด (จ่ายเต็มทุกครั้ง) แต่ sonnet-5 ติด
# AI_SYSTEM_PROMPT=...    # เขียนทับบทบาท/กติกาการตอบทั้งหมด (ไม่ใส่ = ใช้ค่าใน ai-bot.js)
# AI_KNOWLEDGE_DIR=knowledge  # โฟลเดอร์ข้อมูลสินค้าให้ AI อ่าน (ไม่ใส่ = ใช้ knowledge/)

# เขียน log ลงไฟล์ด้วย — เว้นว่างไว้ถ้าไม่ต้องการ
LOG_FILE=chat.log

# ---- ตัวเลือก ------------------------------------------------------------
# ถ้ามี token อยู่แล้ว (คัดลอกจากคุกกี้เบราว์เซอร์) ใส่ตรงนี้ได้
# สคริปต์จะลองใช้ตัวนี้ก่อน ถ้ายังใช้ได้ก็ไม่ต้องล็อกอินเลย
# DUOKE_TOKEN=
